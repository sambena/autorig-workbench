# samples/ is the default models root: only the bundled samples are committed, never models added to it.
samples/*
!samples/README.md
!samples/beetle/
!samples/biped/
!samples/canine/
!samples/pedestal/
!samples/wyvern/

# Outputs. The tool writes next to the models it is pointed at (AUTORIG_MODELS) and into AUTORIG_WORK.
samples/_autorig/
samples/*/_autorig/
samples/*/rigged/
samples/*/rigged_v2/
samples/*/clips/
samples/*/model.json
samples/*/pack.json
_autorig/
rigged/
rigged_v2/
clips/
_studio/
*.blend
*.blend1
*.fbx
*.fbm/
*.zip

__pycache__/
*.pyc

# Local editor and preview settings (paths on one machine).
.claude/
.autorig_roots.json
# AI Assist settings (API keys) and its spend log, on this machine only.
.autorig_ai.json
.autorig_ai_usage.jsonl

# Mesh2Motion build output (scripts/build_m2m.py); the source is the third_party/mesh2motion-app submodule.
autorig/gui/m2m/

# Which folders the page may open and browse (core/server_config.py): set per server, never committed.
.autorig_server.json

# AI generation settings (provider keys, caps) and its spend log, on this machine only (docs/GENERATE.md).
.autorig_generate.json
.autorig_generate_usage.jsonl
