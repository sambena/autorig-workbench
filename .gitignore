# samples/ is the default models root: only the bundled samples are committed, never models added to it.
samples/*
!samples/README.md
!samples/beetle/
!samples/biped/
!samples/canine/
!samples/pedestal/
!samples/wyvern/

# Outputs. The tool writes next to the models it is pointed at (AUTORIG_MODELS) and into AUTORIG_WORK.
samples/_autorig/
samples/*/_autorig/
samples/*/rigged/
samples/*/rigged_v2/
samples/*/clips/
samples/*/model.json
samples/*/pack.json
_autorig/
rigged/
rigged_v2/
clips/
*.blend
*.blend1
*.fbx
*.fbm/
*.zip

__pycache__/
*.pyc

# Local editor and preview settings (paths on one machine).
.claude/
